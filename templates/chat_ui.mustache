<div id="{{containerid}}" class="{{containerclasses}}">
  <div class="llm-header">
    <div>
      <div class="llm-title">
        <span class="llm-ai-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8V4H8"></path>
            <rect x="4" y="8" width="16" height="12" rx="2"></rect>
            <path d="M2 14h2"></path>
            <path d="M20 14h2"></path>
            <path d="M9 13h.01"></path>
            <path d="M15 13h.01"></path>
            <path d="M9 17h6"></path>
          </svg>
        </span>
        <span>{{title}}</span>
      </div>

      {{#subtitle}}
      <div class="llm-subtitle">{{subtitle}}</div>
      {{/subtitle}}
    </div>

    <div class="llm-actions">
      {{#showopenbutton}}
      <button type="button"
              id="{{openbuttonid}}"
              class="llm-icon-btn"
              title="Expand chat"
              aria-label="Expand chat">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 3 21 3 21 9"></polyline>
          <polyline points="9 21 3 21 3 15"></polyline>
          <line x1="21" y1="3" x2="14" y2="10"></line>
          <line x1="3" y1="21" x2="10" y2="14"></line>
        </svg>
      </button>
      {{/showopenbutton}}

      <button type="button"
              id="{{clearbuttonid}}"
              class="llm-icon-btn"
              title="Clear chat"
              aria-label="Clear chat">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M20 20H7.5a2 2 0 0 1-1.4-.6l-3.5-3.5a2 2 0 0 1 0-2.8l8.6-8.6a2 2 0 0 1 2.8 0l5 5a2 2 0 0 1 0 2.8L12 20"></path>
          <path d="M6 13l5 5"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="{{chatwindowid}}" class="llm-chat-window {{chatwindowclasses}}"></div>

  <div class="{{inputwrapclass}}">
    <textarea id="{{inputid}}" class="llm-input" rows="1" placeholder="{{placeholder}}"></textarea>
    <button type="button"
            id="{{sendbuttonid}}"
            class="llm-send-icon"
            title="Send message"
            aria-label="Send message">
      <span class="llm-send-icon__send" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <path fill="currentColor" d="M2 21l21-9L2 3v7l15 2-15 2v7z"></path>
        </svg>
      </span>

      <span class="llm-send-icon__stop" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <rect x="5" y="5" width="14" height="14" rx="2" fill="currentColor"></rect>
        </svg>
      </span>
    </button>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.6/dist/purify.min.js"></script>